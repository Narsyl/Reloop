// Subscription Operations Platform — foundation schema (Phase 1)
// Source of truth for the domain model. See docs/ARCHITECTURE.md §4–§5 and §21.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ═══════════════════════════ Identity & tenancy ═══════════════════════════

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships OrganizationMembership[]
  sessions    Session[]
  accounts    Account[]
}

// Better Auth managed tables (Session / Account / Verification)
model Session {
  id                   String   @id @default(cuid())
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  issuer                String // Better Auth ≥1.7: "local:credential" for password accounts
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  timezone        String   @default("Europe/London")
  currency        String   @default("GBP")
  markerLeadHours Int      @default(72) // D6: attach marker this many hours before target charge
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships        OrganizationMembership[]
  integrations       Integration[]
  customers          Customer[]
  products           Product[]
  productVariants    ProductVariant[]
  programs           SubscriptionProgram[]
  programProducts    SubscriptionProgramProduct[]
  fulfillmentMarkers FulfillmentMarker[]
  subscriptions      Subscription[]
  journeys           SubscriptionJourney[]
  journeyCycles      JourneyCycle[]
  rules              AutomationRule[]
  actions            AutomationAction[]
  events             IntegrationEvent[]
  exceptions         Exception[]
  activityLogs       ActivityLog[]
  syncs              IntegrationSync[]
  subscriptionOrders SubscriptionOrder[]
  plannerRuns        PlannerRun[]
  rewardItems        RewardItem[]
  rewardSchedules    RewardSchedule[]
  rewardMilestones   RewardScheduleMilestone[]
  milestoneMarkers   ProgramMilestoneMarker[]
}

enum OrganizationRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ═══════════════════════════ Integrations ═══════════════════════════

enum IntegrationProvider {
  RECHARGE
  SHOPIFY // catalogue + fulfilment-marker identity/verification ONLY (Phase 4c) — never orders, customers, fulfilments
}

enum IntegrationStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

// Rollout control: OFF = never write; DRY_RUN = plan + validate, log "would attach"; LIVE = write.
enum AutomationMode {
  OFF
  DRY_RUN
  LIVE
}

model Integration {
  id                    String              @id @default(cuid())
  organizationId        String
  provider              IntegrationProvider
  status                IntegrationStatus   @default(CONNECTED)
  externalStoreId       String
  displayName           String
  encryptedCredentials  String // AES-256-GCM blob; excluded from default selects; never logged
  credentialsKeyId      String              @default("v1")
  automationMode        AutomationMode      @default(OFF)
  settingsJson          Json?
  capabilitiesJson      Json?
  capabilitiesCheckedAt DateTime?
  lastSuccessfulSyncAt  DateTime?
  lastErrorAt           DateTime?
  lastErrorMessage      String?
  // Phase 4c: a SHOPIFY integration is paired with the RECHARGE integration whose one-times will reference its variants
  pairedIntegrationId   String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pairedIntegration  Integration?        @relation("IntegrationPairing", fields: [pairedIntegrationId], references: [id], onDelete: SetNull)
  pairedBy           Integration[]       @relation("IntegrationPairing")
  shopifyMarkers     FulfillmentMarker[] @relation("MarkerShopifyIntegration")
  customers          Customer[]
  products           Product[]
  subscriptions      Subscription[]
  actions            AutomationAction[]
  events             IntegrationEvent[]
  exceptions         Exception[]
  syncs              IntegrationSync[]
  subscriptionOrders SubscriptionOrder[]
  fulfillmentMarkers FulfillmentMarker[]
  plannerRuns        PlannerRun[]

  @@unique([organizationId, provider, externalStoreId])
  @@index([organizationId])
}

// ═══════════════════════════ Catalogue, customers, programs ═══════════════════════════

model Customer {
  id                 String    @id @default(cuid())
  organizationId     String
  integrationId      String
  externalCustomerId String
  email              String?
  firstName          String?
  lastName           String?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration   Integration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([integrationId, externalCustomerId])
  @@index([organizationId, email])
  @@index([organizationId, lastName, firstName])
}

enum ProductType {
  SUBSCRIPTION_PRODUCT
  FULFILMENT_MARKER
  GIFT_PRODUCT
}

model Product {
  id                String      @id @default(cuid())
  organizationId    String
  integrationId     String
  externalProductId String
  title             String
  type              ProductType @default(SUBSCRIPTION_PRODUCT)
  active            Boolean     @default(true)
  providerData      Json? // restrained snapshot: provider product id, handle, image — debugging only
  lastSyncedAt      DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration     Integration                  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  programProducts SubscriptionProgramProduct[]
  subscriptions   Subscription[]
  journeys        SubscriptionJourney[]

  @@unique([integrationId, externalProductId])
  @@index([organizationId, type, active])
}

model ProductVariant {
  id                String   @id @default(cuid())
  organizationId    String
  productId         String
  externalVariantId String
  title             String
  sku               String?
  price             Decimal? @db.Decimal(10, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product         Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  markers         FulfillmentMarker[]
  programProducts SubscriptionProgramProduct[]
  subscriptions   Subscription[]
  journeys        SubscriptionJourney[]

  @@unique([productId, externalVariantId])
  @@index([organizationId, sku])
}

// D7: a SubscriptionProgram defines which products/variants share ONE milestone journey.
model SubscriptionProgram {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Reward configuration (Phase 4b): one reusable schedule per programme. Configuration only —
  // lifecycle continuity (journeys, cycles) never depends on it.
  rewardScheduleId         String?
  rewardScheduleAssignedAt DateTime?
  // Phase 4c: warehouse naming for this programme's fulfilment markers — "<markerLabel> <delivery>", SKU "<skuPrefix>-CYCLE-NN"
  markerLabel              String?
  skuPrefix                String?

  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products         SubscriptionProgramProduct[]
  journeys         SubscriptionJourney[]
  rules            AutomationRule[]
  rewardSchedule   RewardSchedule?              @relation(fields: [rewardScheduleId], references: [id], onDelete: SetNull)
  milestoneMarkers ProgramMilestoneMarker[]
  actions          AutomationAction[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

// Membership of a product (all variants) or one specific variant in a program.
// variantScope = variantId, or "*" for product-level. Unique per (org, product, scope) so any
// product/variant resolves to AT MOST ONE program; a variant-level row wins over a "*" row.
model SubscriptionProgramProduct {
  id             String   @id @default(cuid())
  organizationId String
  programId      String
  productId      String
  variantId      String?
  variantScope   String   @default("*")
  createdAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program      SubscriptionProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId, variantScope])
  @@index([programId])
}

enum MarkerSource {
  MANUAL // operator typed the external variant id (Shopify-checkout stores: /products unavailable)
  CATALOGUE // chosen from an API-imported catalogue variant
  DISCOVERED_ONETIME // pre-filled from an existing one-time seen in the provider (read-only discovery)
}

// The £0 item inserted into a shipment. Its EXECUTION identity is the external
// variant id, scoped to ONE integration (a Shopify variant id from store A is never
// usable for store B). SKU/title are operator-verification fields only.
model FulfillmentMarker {
  id                          String                @id @default(cuid())
  organizationId              String
  integrationId               String
  name                        String
  description                 String?
  variantId                   String                @unique
  externalVariantId           String
  externalProductId           String?
  title                       String? // external item title as the fulfilment team sees it, e.g. "Morning Magic 2"
  sku                         String?
  source                      MarkerSource          @default(MANUAL)
  active                      Boolean               @default(true)
  // Configuration-only stand-in (e.g. a discovered paid one-time used to validate a rule).
  // Never executable: READY rules and the planner refuse placeholder markers.
  placeholder                 Boolean               @default(false)
  // Operational meaning (what physically happens) — organisation-owned RewardItem, e.g. "Cup".
  rewardItemId                String?
  operationalNote             String?
  // Phase 4c — Shopify catalogue identity/verification (secondary to the canonical external variant id above).
  // The Shopify integration is the catalogue side; `integrationId` stays the Recharge store that executes one-times.
  shopifyIntegrationId        String?
  shopifyStatus               String? // ACTIVE | UNLISTED | DRAFT | ARCHIVED as last read
  shopifyPublishedOnlineStore Boolean?
  shopifyPrice                String?
  shopifyInventoryTracked     Boolean?
  shopifyHandle               String?
  lastVerifiedAt              DateTime?
  verificationJson            Json? // last read snapshot + issues — debug/secondary only
  rechargeCompatibility       RechargeCompatibility @default(UNVERIFIED)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration        Integration              @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  shopifyIntegration Integration?             @relation("MarkerShopifyIntegration", fields: [shopifyIntegrationId], references: [id], onDelete: SetNull)
  variant            ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  rewardItem         RewardItem?              @relation(fields: [rewardItemId], references: [id], onDelete: SetNull)
  milestoneBindings  ProgramMilestoneMarker[]
  rules              AutomationRule[]
  actions            AutomationAction[]

  @@unique([organizationId, name])
  @@unique([integrationId, externalVariantId])
  @@unique([shopifyIntegrationId, externalVariantId])
  @@index([organizationId, active])
}

/// Whether Recharge's one-time API has been proven to accept this marker's Shopify state (UNLISTED + Online Store).
/// Stays UNVERIFIED until the first controlled Recharge test (Phase 6).
enum RechargeCompatibility {
  UNVERIFIED
  VERIFIED
  INCOMPATIBLE
}

// ═══════════════════════════ Subscriptions & journeys ═══════════════════════════

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  UNKNOWN
}

enum MappingStatus {
  MAPPED
  UNMAPPED
}

enum AutomationOverride {
  ENABLED
  DISABLED
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  integrationId          String
  customerId             String?
  externalSubscriptionId String
  externalCustomerId     String
  externalAddressId      String
  status                 SubscriptionStatus @default(UNKNOWN)
  externalStatus         String?
  mappingStatus          MappingStatus      @default(UNMAPPED)

  productId            String?
  variantId            String?
  externalProductId    String
  externalVariantId    String
  productTitleSnapshot String
  variantTitleSnapshot String?
  skuSnapshot          String?

  quantity           Int                 @default(1)
  price              Decimal?            @db.Decimal(10, 2)
  intervalUnit       String?
  intervalFrequency  Int?
  nextChargeDate     String? // YYYY-MM-DD as Recharge gives it
  nextChargeAt       DateTime? // local midnight of nextChargeDate in org timezone
  externalCreatedAt  DateTime?
  cancelledAt        DateTime?
  automationOverride AutomationOverride?
  providerData       Json? // restrained snapshot: cancellation reason, charge interval, has_queued_charge, address id — debugging/reconciliation only

  // The LATEST programme segment of this provider subscription. It says nothing about
  // whether that journey is open, actionable or eligible — see lib/domain/eligibility.
  latestJourneyId String?   @unique
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration   Integration           @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  customer      Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  latestJourney SubscriptionJourney?  @relation("LatestJourney", fields: [latestJourneyId], references: [id], onDelete: SetNull)
  journeys      SubscriptionJourney[] @relation("SubscriptionJourneys")
  orders        SubscriptionOrder[]
  actions       AutomationAction[]
  exceptions    Exception[]

  @@unique([integrationId, externalSubscriptionId])
  @@index([organizationId, status])
  @@index([organizationId, mappingStatus])
  @@index([organizationId, nextChargeAt])
  @@index([customerId])
}

enum JourneyEndReason {
  PROGRAM_CHANGE
  CANCELLED
  EXPIRED
  UNMAPPED
  MANUAL
}

// One program's run within a subscription. Cycles, rules and actions hang off the journey.
model SubscriptionJourney {
  id                String            @id @default(cuid())
  organizationId    String
  subscriptionId    String
  programId         String
  productId         String?
  variantId         String?
  externalProductId String
  externalVariantId String
  sequence          Int
  startedAt         DateTime
  endedAt           DateTime?
  endReason         JourneyEndReason?
  successfulCycles  Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription        @relation("SubscriptionJourneys", fields: [subscriptionId], references: [id], onDelete: Cascade)
  program      SubscriptionProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  product      Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  latestOf     Subscription?       @relation("LatestJourney")
  cycles       JourneyCycle[]
  actions      AutomationAction[]
  exceptions   Exception[]

  @@unique([subscriptionId, sequence])
  @@index([organizationId, programId])
}

enum CycleSource {
  WEBHOOK
  BACKFILL
  MANUAL
}

enum OrderKind {
  CHECKOUT
  RECURRING
}

// One successful order counted for a journey. Unique on order id → idempotent counting.
model JourneyCycle {
  id               String      @id @default(cuid())
  organizationId   String
  journeyId        String
  cycleNumber      Int
  externalOrderId  String
  externalChargeId String?
  orderKind        OrderKind
  processedAt      DateTime
  source           CycleSource
  sourceEventId    String?
  createdAt        DateTime    @default(now())

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journey          SubscriptionJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  sourceEvent      IntegrationEvent?   @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  fulfilledActions AutomationAction[]

  @@unique([journeyId, externalOrderId])
  @@unique([journeyId, cycleNumber])
  @@index([organizationId, processedAt])
}

// ═══════════════════════════ Rules & actions ═══════════════════════════

enum RuleTriggerType {
  SUBSCRIPTION_CYCLE
}

enum RuleActionType {
  ADD_FULFILLMENT_MARKER
}

enum ExistingSubscriptionPolicy {
  FUTURE_ONLY
  INCLUDE_EXISTING
}

// Rule lifecycle. ACTIVE is the only state that can ever plan actions; it is not
// reachable until the Action Engine phase (server-enforced).
enum RuleStatus {
  DRAFT // being configured; may be incomplete
  READY // fully valid, scope chosen; awaiting activation (no actions)
  ACTIVE // plans actions (Phase 4+); not settable in Phase 3
  DISABLED // was configured/active; intentionally off
  ARCHIVED // retired; frees the milestone for a new rule
}

// Who "counts" towards a milestone — a planning-time business policy, never a
// change to journey history.
enum EligibilityScope {
  PER_SUBSCRIPTION // each provider subscription restarts milestone eligibility
  CUSTOMER_PROGRAM // lifetime deliveries of the same provider customer in this programme count
}

model AutomationRule {
  id                    String                     @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  status                RuleStatus                 @default(DRAFT)
  priority              Int                        @default(100)
  triggerType           RuleTriggerType            @default(SUBSCRIPTION_CYCLE)
  programId             String
  cycleNumber           Int // >= 2 (delivery 1 is the checkout order; DB check constraint + domain validation)
  actionType            RuleActionType             @default(ADD_FULFILLMENT_MARKER)
  fulfillmentMarkerId   String
  eligibilityScope      EligibilityScope? // must be chosen before READY
  existingPolicy        ExistingSubscriptionPolicy @default(FUTURE_ONLY)
  // V1 milestone uniqueness: "<organizationId>:<programId>:<cycleNumber>" while the rule is
  // DRAFT/READY/ACTIVE/DISABLED; NULL when ARCHIVED. One rule per programme milestone.
  milestoneKey          String?                    @unique
  // Phase 4b: rules are legacy; when migrated into a schedule milestone the link is kept here for audit
  migratedToMilestoneId String?
  activatedAt           DateTime?
  lastTriggeredAt       DateTime?
  createdById           String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program           SubscriptionProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  fulfillmentMarker FulfillmentMarker   @relation(fields: [fulfillmentMarkerId], references: [id], onDelete: Restrict)
  actions           AutomationAction[]
  exceptions        Exception[]

  @@unique([organizationId, name])
  @@index([organizationId, status, programId, cycleNumber])
}

enum ActionType {
  ADD_FULFILLMENT_MARKER
}

enum ActionSource {
  RULE
  MANUAL
  BACKFILL
}

// D6 state model:
//   PLANNED    decided; no external write yet (visible in Upcoming immediately)
//   EXECUTING  attach in progress
//   ATTACHED   one-time exists in Recharge on the target date
//   FULFILLED  target cycle's order processed AND contained the marker line
//   FAILED     terminal error (Exception raised)  |  CANCELLED  no longer applicable (reason recorded)
//   SUPERSEDED replaced by a newer live action for the same milestone
enum ActionStatus {
  PLANNED
  EXECUTING
  ATTACHED
  FULFILLED
  FAILED
  CANCELLED
  SUPERSEDED
}

model AutomationAction {
  id                  String       @id @default(cuid())
  organizationId      String
  integrationId       String
  ruleId              String?
  subscriptionId      String
  journeyId           String
  fulfillmentMarkerId String
  type                ActionType   @default(ADD_FULFILLMENT_MARKER)
  source              ActionSource @default(RULE)
  targetCycle         Int
  status              ActionStatus @default(PLANNED)

  // Idempotency: "<journeyId>:<targetCycle>:<fulfillmentMarkerId>" while status is live
  // (PLANNED / EXECUTING / ATTACHED / FULFILLED / FAILED); NULL when CANCELLED / SUPERSEDED.
  liveKey                   String?           @unique
  // Scope-level owner of the milestone (Phase 4): PER_SUBSCRIPTION → "j:<journeyId>:<cycle>:<markerId>",
  // CUSTOMER_PROGRAM → "c:<customerId>:<programId>:<cycle>:<markerId>". Same lifetime as liveKey.
  ownerKey                  String?           @unique
  eligibilityScope          EligibilityScope?
  // Phase 4b: the effective milestone this action was planned from (rules are legacy)
  rewardScheduleMilestoneId String?
  programId                 String?
  plannerRunId              String?
  lastPlannedAt             DateTime?
  replanCount               Int               @default(0)
  supersededById            String?

  targetChargeDate String? // YYYY-MM-DD (Recharge date-only value)
  targetChargeAt   DateTime? // local midnight of targetChargeDate in org timezone
  executeAfter     DateTime? // targetChargeAt - markerLeadHours (or now, if already inside the window)
  executedAt       DateTime?
  verifiedAt       DateTime?

  externalObjectType String?
  externalObjectId   String?
  externalChargeDate String?
  externalAddressId  String?
  fulfilledByCycleId String?

  dryRun         Boolean   @default(false)
  // DRY_RUN executor output (Phase 4): structured preview of what WOULD be sent, never sent
  lastDryRunAt   DateTime?
  dryRunJson     Json?
  wouldExecute   Boolean?
  blockingReason String?
  attemptCount   Int       @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  cancelReason   String?

  triggeredByEventId String?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration       Integration              @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  rule              AutomationRule?          @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  subscription      Subscription             @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  journey           SubscriptionJourney      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  fulfillmentMarker FulfillmentMarker        @relation(fields: [fulfillmentMarkerId], references: [id], onDelete: Restrict)
  fulfilledByCycle  JourneyCycle?            @relation(fields: [fulfilledByCycleId], references: [id], onDelete: SetNull)
  triggeredByEvent  IntegrationEvent?        @relation(fields: [triggeredByEventId], references: [id], onDelete: SetNull)
  plannerRun        PlannerRun?              @relation(fields: [plannerRunId], references: [id], onDelete: SetNull)
  milestone         RewardScheduleMilestone? @relation(fields: [rewardScheduleMilestoneId], references: [id], onDelete: SetNull)
  program           SubscriptionProgram?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  exceptions        Exception[]

  @@index([organizationId, status, targetChargeAt])
  @@index([status, executeAfter])
  @@index([subscriptionId])
}

enum PlannerRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// One execution of the action planner for an integration (after a sync, on demand, or by cron).
/// History for the Upcoming page and for proving idempotency: counts of evaluated / planned /
/// replanned / cancelled / superseded / skipped.
model PlannerRun {
  id             String           @id @default(cuid())
  organizationId String
  integrationId  String
  status         PlannerRunStatus @default(RUNNING)
  trigger        String // SYNC | MANUAL | CRON | TEST
  automationMode AutomationMode
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?
  countsJson     Json?
  detailsJson    Json?
  error          String?
  triggeredById  String?
  createdAt      DateTime         @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  actions      AutomationAction[]

  @@index([organizationId, integrationId, startedAt])
}

// ═══════════════════════════ Reward configuration (Phase 4b) ═══════════════════════════

/// What physically happens at a milestone ("Whisk", "Cup", "Spoon", "sample sachet"…). Organisation-owned;
/// no inventory, pricing or stock — operator meaning and auditability only.
model RewardItem {
  id                     String   @id @default(cuid())
  organizationId         String
  name                   String
  description            String?
  operationalDescription String?
  active                 Boolean  @default(true)
  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones   RewardScheduleMilestone[]
  markers      FulfillmentMarker[]

  @@unique([organizationId, name])
}

enum RewardScheduleStatus {
  DRAFT
  READY
  ARCHIVED
}

/// Reusable milestone configuration shared by many programmes. Configuration only: programmes keep
/// their own journeys and their own CUSTOMER_PROGRAM histories.
model RewardSchedule {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         RewardScheduleStatus @default(DRAFT) // DRAFT → READY (usable by the dry-run planner) → ARCHIVED; no ACTIVE
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones   RewardScheduleMilestone[]
  programs     SubscriptionProgram[]

  @@unique([organizationId, name])
}

enum MilestoneExecutionMode {
  UPCOMING_RENEWAL // planned before a future charge by the renewal planner
  INITIAL_CHECKOUT // part of the first order by construction; recorded, never planned by the renewal planner
}

model RewardScheduleMilestone {
  id               String                 @id @default(cuid())
  organizationId   String
  scheduleId       String
  cycleNumber      Int // delivery number the reward belongs to
  rewardItemId     String
  executionMode    MilestoneExecutionMode
  eligibilityScope EligibilityScope // required — chosen explicitly when the milestone is created
  active           Boolean                @default(true)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule     RewardSchedule           @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  rewardItem   RewardItem               @relation(fields: [rewardItemId], references: [id], onDelete: Restrict)
  bindings     ProgramMilestoneMarker[]
  actions      AutomationAction[]

  @@unique([scheduleId, cycleNumber])
  @@index([organizationId])
}

/// "For this programme, when this schedule milestone occurs, use this external marker."
model ProgramMilestoneMarker {
  id                        String   @id @default(cuid())
  organizationId            String
  programId                 String
  rewardScheduleMilestoneId String
  fulfillmentMarkerId       String
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program           SubscriptionProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  milestone         RewardScheduleMilestone @relation(fields: [rewardScheduleMilestoneId], references: [id], onDelete: Cascade)
  fulfillmentMarker FulfillmentMarker       @relation(fields: [fulfillmentMarkerId], references: [id], onDelete: Restrict)

  @@unique([programId, rewardScheduleMilestoneId])
  @@index([organizationId])
}

// ═══════════════════════════ Event inbox ═══════════════════════════

enum IntegrationEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

// Webhook deliveries received directly by this platform. Never populated from a provider "events" API.
model IntegrationEvent {
  id              String                 @id @default(cuid())
  organizationId  String
  integrationId   String
  provider        IntegrationProvider
  eventType       String
  externalEventId String?
  dedupeKey       String
  payloadJson     Json
  headersJson     Json?
  signatureValid  Boolean
  receivedAt      DateTime               @default(now())
  dispatchedAt    DateTime?
  processedAt     DateTime?
  status          IntegrationEventStatus @default(RECEIVED)
  attemptCount    Int                    @default(0)
  lastError       String?

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration   Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  journeyCycles JourneyCycle[]
  actions       AutomationAction[]

  @@unique([integrationId, dedupeKey])
  @@index([status, receivedAt])
  @@index([organizationId, receivedAt])
}

// ═══════════════════════════ Exceptions & activity ═══════════════════════════

enum ExceptionSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ExceptionStatus {
  OPEN
  RESOLVED
  IGNORED
}

model Exception {
  id             String            @id @default(cuid())
  organizationId String
  severity       ExceptionSeverity
  type           String
  title          String
  description    String
  status         ExceptionStatus   @default(OPEN)
  autoResolved   Boolean           @default(false)
  integrationId  String?
  subscriptionId String?
  journeyId      String?
  ruleId         String?
  actionId       String?
  metadataJson   Json?
  detectedAt     DateTime          @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration?         @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  journey      SubscriptionJourney? @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  rule         AutomationRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  action       AutomationAction?    @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, severity])
  @@index([organizationId, detectedAt])
}

enum ActorType {
  USER
  SYSTEM
  INTEGRATION
}

enum EntityType {
  ORGANIZATION
  USER
  INTEGRATION
  PRODUCT
  PROGRAM
  FULFILLMENT_MARKER
  SUBSCRIPTION
  JOURNEY
  RULE
  ACTION
  EXCEPTION
  EVENT
  REWARD_SCHEDULE
  REWARD_ITEM
}

model ActivityLog {
  id             String     @id @default(cuid())
  organizationId String
  actorType      ActorType
  actorId        String?
  eventType      String
  entityType     EntityType
  entityId       String
  summary        String
  metadataJson   Json?
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

// ═══════════════════════════ Sync runs & imported order history ═══════════════════════════

enum SyncKind {
  INITIAL
  INCREMENTAL
  RECALCULATE_JOURNEYS
}

enum SyncStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SyncStage {
  CONNECTING
  PRODUCTS
  CUSTOMERS
  SUBSCRIPTIONS
  ORDERS
  ONETIMES
  JOURNEYS
  COMPLETE
}

// One operator/system-triggered sync run. Persistent progress (stage, cursor, counts)
// lives here so the UI can show where a run is and a retry can resume — Inngest is
// execution, this is the record.
model IntegrationSync {
  id              String     @id @default(cuid())
  organizationId  String
  integrationId   String
  kind            SyncKind
  status          SyncStatus @default(QUEUED)
  stage           SyncStage  @default(CONNECTING)
  triggeredById   String?
  inngestRunId    String?
  updatedSince    DateTime? // INCREMENTAL: only records updated after this instant
  progressJson    Json? // { stage: { cursor, pages, items, done } }
  countsJson      Json? // final/rolling counts: products, variants, customers, subscriptions, orders, cycles, unmapped
  error           String?
  lastHeartbeatAt DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@index([organizationId, status])
}

// One successful provider ORDER line for one provider SUBSCRIPTION — the durable fact
// journeys are calculated from. Written by sync/webhooks, never deleted by recalculation.
// Unique per (integration, order, subscription) → importing the same order twice is a no-op.
model SubscriptionOrder {
  id                     String    @id @default(cuid())
  organizationId         String
  integrationId          String
  subscriptionId         String? // linked once the Subscription row exists
  externalSubscriptionId String
  externalOrderId        String
  externalChargeId       String?
  externalCustomerId     String?
  externalAddressId      String?
  orderKind              OrderKind
  orderStatus            String // provider status at import time (we only store success)
  processedAt            DateTime
  externalProductId      String
  externalVariantId      String
  quantity               Int       @default(1)
  productTitle           String?
  providerData           Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([integrationId, externalOrderId, externalSubscriptionId])
  @@index([subscriptionId, processedAt])
  @@index([integrationId, externalSubscriptionId, processedAt])
}
