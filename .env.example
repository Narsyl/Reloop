# ── Database (Neon) ─────────────────────────────────────────────────────────
# Pooled connection for the app
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Direct (unpooled) connection for Prisma migrations / db push
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
# DEDICATED shadow database for `npm run db:diff` / `npm run db:migrate:dev` — on Neon use a SEPARATE BRANCH.
# Prisma DROPS the shadow schema. scripts/db/safe-prisma.mjs refuses to run if this is missing or points at the
# same database as DATABASE_URL. Read docs/DB-MIGRATIONS.md.
SHADOW_DATABASE_URL=

# ── Auth (Better Auth) ─────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Credential encryption (AES-256-GCM) ────────────────────────────────────
# Comma-separated "keyId:base64(32 bytes)". First entry is the current key; older
# entries remain so existing rows can be decrypted and rotated.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES

# ── Background execution (Inngest) ─────────────────────────────────────────
# Leave empty for local dev with `npm run inngest:dev`
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Recharge (connector defaults; merchant tokens live encrypted in the DB) ─
RECHARGE_API_VERSION=2021-11
